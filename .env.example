# Copy to .env (git-ignored). Every value has a default in docker-compose.yaml.

# Linux only: run `echo "AIRFLOW_UID=$(id -u)" >> .env` so files in logs/ and data/
# belong to you. Docker Desktop on macOS/Windows doesn't need it.
AIRFLOW_UID=50000

# Host ports
AIRFLOW_HOST_PORT=8080
DVF_PG_HOST_PORT=5433

# DVF database. Credentials are applied on first boot only (when ./pgdata is empty).
DVF_DB_NAME=dvf
DVF_DB_USER=dvf
DVF_DB_PASSWORD=dvf

# Airflow secrets. Change these if the stack is reachable from outside localhost.
AIRFLOW_JWT_SECRET=local-dev-only-jwt-secret-change-me
FERNET_KEY=
